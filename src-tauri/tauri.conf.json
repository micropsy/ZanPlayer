{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Sub Player",
  "version": "0.0.0",
  "identifier": "com.sub-player.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sub Player",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "open": true
    },
    "fs": {
      "scope": ["**/*"]
    },
    "dialog": {},
    "path": {},
    "http": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
