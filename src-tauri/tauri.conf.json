{
  "$schema": "https://schema.tauri.app/v2/config/2.11.0",
  "productName": "Sub Player",
  "version": "0.1.0",
  "identifier": "com.sub-player.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sub Player",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/micropsy/subplayer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4MDNFNTU3MTgxNzM3REMKUldUY054Y1lWK1VET0R6Tk1DTTFoZXhiaHk1ajNNUEVLeE4zRzZSLzhIQ1FQdWdaa3ByaGhSei8K",
      "installMode": "passive"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
